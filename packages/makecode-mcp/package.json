{
  "name": "makecode-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./browser": "./dist/browser/index.js",
    "./server": "./dist/server/index.js"
  },
  "bin": {
    "makecode-mcp": "./dist/server/bin.js"
  },
  "scripts": {
    "build": "tsc -b && node scripts/build-shim.mjs",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "test": "vitest run",
    "dev:test-page": "vite --config test-page/vite.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "start:server": "node dist/server/bin.js",
    "dev:test-mcp": "npm run build && npx @modelcontextprotocol/inspector node dist/server/bin.js --headed",
    "dev:test-mcp-headless": "npm run build && npx @modelcontextprotocol/inspector node dist/server/bin.js"
  },
  "dependencies": {
    "@microbit/makecode-embed": "^0.5.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chrome-launcher": "^1.2.1",
    "puppeteer": "^23.0.0",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.0",
    "vite": "^8.0.8"
  }
}
